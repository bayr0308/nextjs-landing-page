{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    ".taste-skill/**",
    ".qa/**"
  ]
}
